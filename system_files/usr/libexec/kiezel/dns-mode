#!/usr/bin/bash
# DNS mode (ADR-0012, docs/hardening.md §3). Run as root.
#   quad9          default: Quad9 with DNS-over-TLS when possible; the network's DNS for local
#                  names and as automatic fallback
#   router         privacy choice "off": only the network's (router's) DNS, as without Kiezel
#   strict <prov>  Advanced: only encrypted DNS to quad9|cloudflare, no fallback at all
#                  (DNS stops working on networks that block port 853, by design)
set -euo pipefail

dropin=/etc/systemd/resolved.conf.d/90-kiezel-dns-mode.conf
# "status" needs no privileges (the Welcome Center page reads it as the user).
if [[ "${1:-}" == status ]]; then
    echo "mode: $(cat /etc/kiezel/dns-mode 2>/dev/null || echo quad9)"
    resolvectl status | grep -E 'DNSOverTLS|Current DNS|Default Route' | head -6; exit 0
fi
mkdir -p /etc/kiezel /etc/systemd/resolved.conf.d
case "${1:-}" in
    quad9)
        rm -f "${dropin}"; echo quad9 > /etc/kiezel/dns-mode ;;
    router)
        # An empty DNS= resets the Quad9 list from the vendor drop-in.
        printf '# Written by ujust kiezel-dns-router\n[Resolve]\nDNS=\nDNSOverTLS=opportunistic\n' > "${dropin}"
        echo router > /etc/kiezel/dns-mode ;;
    strict)
        case "${2:-quad9}" in
            quad9)      servers="9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net 2620:fe::9#dns.quad9.net" ;;
            cloudflare) servers="1.1.1.1#cloudflare-dns.com 1.0.0.1#cloudflare-dns.com 2606:4700:4700::1111#cloudflare-dns.com" ;;
            *) echo "unknown provider '${2}' (quad9|cloudflare)" >&2; exit 2 ;;
        esac
        printf '# Written by ujust kiezel-dns-strict\n[Resolve]\nDNS=\nDNS=%s\nDNSOverTLS=yes\nDomains=~.\n' "${servers}" > "${dropin}"
        echo strict > /etc/kiezel/dns-mode ;;
    *) echo "usage: $0 quad9 | router | strict [quad9|cloudflare] | status" >&2; exit 2 ;;
esac
systemctl restart systemd-resolved
/usr/libexec/kiezel/dns-route
